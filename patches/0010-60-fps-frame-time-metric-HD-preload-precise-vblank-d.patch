-    img = src ? CGImageSourceCreateImageAtIndex(src, 0, NULL) : NULL;
+    uint32_t *px;
     if (src) CFRelease(src);
-    if (!img) { s_hd_fail++; return NULL; }
+    if (!img) return NULL;
     W = CGImageGetWidth(img); H = CGImageGetHeight(img);
-    kk = (uint32_t)(W / ti->w);
-    if (kk < 1 || W != ti->w * kk || H != ti->h * kk) {
