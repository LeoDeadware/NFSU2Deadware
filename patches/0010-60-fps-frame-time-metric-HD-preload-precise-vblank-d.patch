 {
-    const char *e = getenv("NFSU2_HD");
+    const char *e = getenv("NFSU2_HD"), *pre = getenv("NFSU2_HD_PRELOAD");
     NSString *dir = nil, *man;
     NSMutableDictionary *idx = [NSMutableDictionary new];
     if (e && (!strcmp(e, "0") || !*e))
@@ -147,10 +216,16 @@ static void hd_init(void)
         idx[@(h)] = [dir stringByAppendingPathComponent:[f[0] stringByAppendingString:@".png"]];
     }
     s_hd = idx;
+    s_pic = [NSMutableDictionary new];
     if (!getenv("RECOMP_GL_TEX_MB"))
         setenv("RECOMP_GL_TEX_MB", "1536", 1);
     nfsu2_tex_add_provider(hd_provide);
     fprintf(stderr, "[hd] %lu HD textures in %s\n", (unsigned long)idx.count, dir.UTF8String);
+    if (!(pre && !strcmp(pre, "0"))) {
+        pthread_t t;
+        if (pthread_create(&t, NULL, hd_preload, NULL) == 0)
+            pthread_detach(t);
+    }
 }
 
 static const uint32_t *replace(const Nv2aTexInfo *ti, uint32_t *k)
