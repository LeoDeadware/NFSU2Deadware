+/* ── HD pack ──
+ * Decoding a PNG costs ~2 ms per 512x512 picture; done on the render thread at first use it made
+ * 50-70 ms hitches mid-race (60 fps budget, owner 2026-11-07). hd_init starts one background thread
+ * that decodes the whole pack ahead (straight-alpha BGRA kept in memory, ~160 MB for the merged
+ * pack); hd_provide takes the decoded copy and decodes synchronously only what the thread has not
+ * reached yet. NFSU2_HD_PRELOAD=0 turns the thread off (decode on first use, as before). */
+typedef struct { uint32_t *px; uint32_t w, h; } HdPic;
 static NSDictionary<NSNumber *, NSString *> *s_hd;       /* hash -> png path */
-static uint32_t *s_px;
-static size_t s_px_cap;
-static unsigned long s_hd_hits, s_hd_fail;
+static NSMutableDictionary<NSNumber *, NSValue *> *s_pic; /* hash -> HdPic (decoded) */
+static pthread_mutex_t s_pic_mu = PTHREAD_MUTEX_INITIALIZER;
