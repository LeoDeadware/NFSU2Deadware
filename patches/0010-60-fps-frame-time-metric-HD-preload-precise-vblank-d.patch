-/* How long the timer thread may sleep before the next vblank is due. */
+/* How long the timer thread may sleep before the next vblank is due.
+ * A millisecond wait rounded up woke up to ~1.2 ms late (flip interval p99
+ * 17.9 ms at 59.94 Hz: the Mac's 60 fps budget, owner 2026-11-07), so the
+ * wait ends VB_FINE_US early and kernel_vblank_tick sleeps the rest to the
+ * microsecond (POSIX; Windows keeps the millisecond wait). */
+#ifndef _WIN32
+#define VB_FINE_US 1500
+#endif
 static DWORD kernel_vblank_wait_ms(void)
 {
     long long d = s_vb_next_us - vb_now_us();
+#ifdef VB_FINE_US
+    if (d <= VB_FINE_US)
+        return 0;
+    d = (d - VB_FINE_US + 999) / 1000;
+#else
     if (d <= 0)
         return 1;
     d = (d + 999) / 1000;
+#endif
     return d > 10 ? 10 : (DWORD)d;
 }
 
@@ -2937,6 +2953,12 @@ static void kernel_vblank_tick(void)
     now = vb_now_us();
     if (!s_vb_next_us)
         s_vb_next_us = now;
+#ifdef VB_FINE_US
+    if (now < s_vb_next_us && s_vb_next_us - now <= VB_FINE_US) {
+        usleep((useconds_t)(s_vb_next_us - now));
+        now = vb_now_us();
+    }
+#endif
     if (now < s_vb_next_us)
         return;
     if (now - s_vb_next_us > VBLANK_PERIOD_US / 2)
diff --git a/xboxrecomp/src/nv2a_metal/nv2a_metal.m b/xboxrecomp/src/nv2a_metal/nv2a_metal.m
