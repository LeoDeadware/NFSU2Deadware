+}
+
+/* Stores a decoded picture unless one is there already; returns the stored one. */
+static HdPic hd_store(NSNumber *key, HdPic pic)
+{
+    NSValue *v;
+    pthread_mutex_lock(&s_pic_mu);
+    v = s_pic[key];
+    if (v) {
+        HdPic old;
+        [v getValue:&old];
+        free(pic.px);
+        pic = old;
+    } else
+        s_pic[key] = [NSValue valueWithBytes:&pic objCType:@encode(HdPic)];
+    pthread_mutex_unlock(&s_pic_mu);
+    return pic;
+}
+
+static void *hd_preload(void *arg)
+{
+    NSDictionary<NSNumber *, NSString *> *hd = s_hd;
+    double t0 = CFAbsoluteTimeGetCurrent();
+    unsigned long n = 0;
+    size_t bytes = 0;
+    (void)arg;
+    pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+    for (NSNumber *key in hd) {
+        @autoreleasepool {
+            HdPic pic = {0};
+            pthread_mutex_lock(&s_pic_mu);
+            BOOL have = s_pic[key] != nil;
+            pthread_mutex_unlock(&s_pic_mu);
+            if (have || !(pic.px = hd_decode(hd[key], &pic.w, &pic.h)))
+                continue;
+            hd_store(key, pic);
+            n++;
+            bytes += (size_t)pic.w * pic.h * 4;
+        }
+    }
+    fprintf(stderr, "[hd] preloaded %lu pictures, %zu MB, in %.0f ms\n", n, bytes >> 20,
+            (CFAbsoluteTimeGetCurrent() - t0) * 1000);
+    return NULL;
+}
+
+static const uint32_t *hd_provide(const Nv2aTexInfo *ti, uint32_t *k)
+{
+    NSNumber *key = @(ti->hash);
+    NSString *path = s_hd[key];
+    NSValue *v;
+    HdPic pic = {0};
+    uint32_t kk;
+    if (!path)
+        return NULL;
+    pthread_mutex_lock(&s_pic_mu);
+    v = s_pic[key];
+    if (v) [v getValue:&pic];
+    pthread_mutex_unlock(&s_pic_mu);
+    if (!v) {
+        if (!(pic.px = hd_decode(path, &pic.w, &pic.h))) { s_hd_fail++; return NULL; }
+        pic = hd_store(key, pic);
+        s_hd_sync++;
+    }
+    kk = pic.w / ti->w;
+    if (kk < 1 || pic.w != ti->w * kk || pic.h != ti->h * kk) {
+        s_hd_fail++;
+        return NULL;
+    }
     if (!s_hd_hits++)
-        fprintf(stderr, "[hd] first HD texture %016llx %ux%u -> %zux%zu\n",
-                (unsigned long long)ti->hash, ti->w, ti->h, W, H);
+        fprintf(stderr, "[hd] first HD texture %016llx %ux%u -> %ux%u\n",
+                (unsigned long long)ti->hash, ti->w, ti->h, pic.w, pic.h);
+    if (s_hd_sync && !(s_hd_sync & (s_hd_sync - 1)) && !v)
+        fprintf(stderr, "[hd] %lu pictures decoded on first use (preload not there yet)\n", s_hd_sync);
     *k = kk;
-    return s_px;
+    return pic.px;
 }
 
