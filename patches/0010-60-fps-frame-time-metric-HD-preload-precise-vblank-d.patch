     }
     CGImageRelease(img);
+    if (!px) return NULL;
     for (i = 0; i < W * H; i++) {                      /* straight alpha again */
-        uint32_t p = s_px[i], a = p >> 24;
+        uint32_t p = px[i], a = p >> 24;
         if (a && a < 255) {
             uint32_t r = ((p >> 16 & 255) * 255 + a / 2) / a, g = ((p >> 8 & 255) * 255 + a / 2) / a,
                      b = ((p & 255) * 255 + a / 2) / a;
-            s_px[i] = a << 24 | (r > 255 ? 255 : r) << 16 | (g > 255 ? 255 : g) << 8 | (b > 255 ? 255 : b);
