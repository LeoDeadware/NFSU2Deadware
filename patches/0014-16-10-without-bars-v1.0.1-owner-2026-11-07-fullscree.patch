diff --git a/src/apple/apple_main.c b/src/apple/apple_main.c
index 41166d1..4eeec48 100644
--- a/src/apple/apple_main.c
+++ b/src/apple/apple_main.c
@@ -27,6 +27,41 @@
 #include <unistd.h>
 
 #include <TargetConditionals.h>
+#if !TARGET_OS_IPHONE
+#include <SDL_syswm.h>
+void apple_window_full_panel(void *nswindow);   /* apple_window.m */
+void apple_window_restore(void);
+int apple_window_notch_on(void);
+static void full_panel(SDL_Window *w)
+{
+    SDL_SysWMinfo i;
+    SDL_VERSION(&i.version);
+    if (w && SDL_GetWindowWMInfo(w, &i) && i.subsystem == SDL_SYSWM_COCOA)
+        apple_window_full_panel((void *)i.info.cocoa.window);
+}
+static int s_full;
+/* Fullscreen: a borderless window over the whole panel (apple_window.m), or SDL's
+ * (NFSU2_NOTCH=0). */
+static void set_full(SDL_Window *w, int on)
+{
+    if (!w)
+        return;
+    s_full = on;
+    if (!apple_window_notch_on()) {
+        SDL_SetWindowFullscreen(w, on ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+        return;
+    }
+    if (on) {
+        SDL_SetWindowBordered(w, SDL_FALSE);
+        full_panel(w);
+    } else {
+        apple_window_restore();
+        SDL_SetWindowBordered(w, SDL_TRUE);
+        SDL_SetWindowSize(w, 1280, 720);
+        SDL_SetWindowPosition(w, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
+    }
+}
+#endif
 #if TARGET_OS_IPHONE
 #if !defined(NFSU2_VULKAN)
 #error "iOS renders with Vulkan (MoltenVK): configure with -DNFSU2_VULKAN=ON"
@@ -340,7 +375,7 @@ int main(int argc, char **argv)
     {
         const char *e = getenv("NFSU2_FULLSCREEN");
         if (s_win && !(e && !strcmp(e, "0")))
-            SDL_SetWindowFullscreen(s_win, SDL_WINDOW_FULLSCREEN_DESKTOP);
+            set_full(s_win, 1);
     }
 #endif
     s_done_event = SDL_RegisterEvents(1);
@@ -400,8 +435,7 @@ int main(int argc, char **argv)
             ios_touch_controllers_changed();
 #else
         if (e.type == SDL_KEYDOWN && e.key.keysym.scancode == SDL_SCANCODE_F11 && !e.key.repeat && s_win)
-            SDL_SetWindowFullscreen(s_win, (SDL_GetWindowFlags(s_win) & SDL_WINDOW_FULLSCREEN_DESKTOP)
-                                           ? 0 : SDL_WINDOW_FULLSCREEN_DESKTOP);
+            set_full(s_win, !s_full);
         apple_keyboard_event(&e);
         if (e.type == SDL_JOYDEVICEADDED || e.type == SDL_JOYDEVICEREMOVED)
             apple_keyboard_controllers_changed();
diff --git a/src/apple/apple_window.m b/src/apple/apple_window.m
new file mode 100644
index 0000000..01f5781
--- /dev/null
+++ b/src/apple/apple_window.m
@@ -0,0 +1,42 @@
+/*
+ * apple_window.m -- fullscreen over the whole panel, the notch strip included
+ * (v1.0.1, owner 2026-11-07 "чорні смуги"). macOS keeps a fullscreen window
+ * (a Space or SDL's non-Space one) below the camera housing: a black strip
+ * at the top of a 16:10 MacBook. Hiding the menu bar and the Dock and giving
+ * the window the screen's whole frame puts the picture there too (the
+ * camera covers a few pixels in the middle). The window is SDL's, borderless
+ * (apple_main.c), not in fullscreen mode: AppKit keeps a fullscreen window's
+ * frame. NFSU2_NOTCH=0: SDL's fullscreen as before.
+ */
+#import <AppKit/AppKit.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+void apple_window_full_panel(void *nswindow)
+{
+    NSWindow *w = (__bridge NSWindow *)nswindow;
+    NSScreen *sc;
+    if (!w)
+        return;
+    sc = w.screen ? w.screen : [NSScreen mainScreen];
+    if (!sc)
+        return;
+    [NSApp setPresentationOptions:NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar];
+    w.level = NSMainMenuWindowLevel + 1;
+    [w setFrame:sc.frame display:YES];
+    fprintf(stderr, "[apple] window over the whole panel %.0fx%.0f pt (notch %.0f pt)\n",
+            sc.frame.size.width, sc.frame.size.height,
+            [sc respondsToSelector:@selector(safeAreaInsets)] ? sc.safeAreaInsets.top : 0.0);
+}
+
+int apple_window_notch_on(void)
+{
+    const char *e = getenv("NFSU2_NOTCH");
+    return !(e && *e == '0');
+}
+
+void apple_window_restore(void)
+{
+    [NSApp setPresentationOptions:NSApplicationPresentationDefault];
+}
