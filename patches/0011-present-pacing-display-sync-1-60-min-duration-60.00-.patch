@@ -3254,6 +3363,21 @@ static void mtl_flip_inner(void)
                         s_ft_flip.n, ft_pct(&s_ft_flip, 0.5), ft_pct(&s_ft_flip, 0.99), s_ft_flip.max,
                         s_ft_flip.missed, ft_pct(&s_ft_gpu, 0.5), ft_pct(&s_ft_gpu, 0.99), s_ft_gpu.max,
