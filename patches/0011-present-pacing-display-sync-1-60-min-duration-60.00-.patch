 xboxrecomp/src/kernel/kernel_bridge.c  |  21 ++++
 xboxrecomp/src/nv2a_metal/nv2a_metal.m | 138 +++++++++++++++++++++++--
 3 files changed, 156 insertions(+), 10 deletions(-)

