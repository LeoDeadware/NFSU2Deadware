+                            ft_pct(&s_ft_pres, 0.99), s_ft_pres.max, s_ft_pres.missed, fast,
+                            s_pres_never, s_pres_err_n ? s_pres_err_sum / s_pres_err_n / 1000.0 : 0.0,
+                            s_pres_err_max / 1000.0);
