 }
 
 static long long     s_vb_next_us;                /* when the next vblank is due */
+/* Display phase lock (nv2a_metal.m present pacing): moves the next vblank by
+ * us (positive = later) so the game's frames land at a fixed phase of the
+ * display's refresh; small steps, called once per presented frame. */
+void xbox_vblank_nudge(long long us)
+{
+    __atomic_fetch_add(&s_vb_next_us, us, __ATOMIC_RELAXED);
+}
+long long xbox_vblank_period_us(void) { return VBLANK_PERIOD_US; }
+long long xbox_vblank_next_us(void) { return __atomic_load_n(&s_vb_next_us, __ATOMIC_RELAXED); }
 static volatile LONG s_vb_count;                  /* vblanks delivered */
 
 /* For the fps reports: "vblank 59.9 Hz" since the previous call, dt s ago. */
