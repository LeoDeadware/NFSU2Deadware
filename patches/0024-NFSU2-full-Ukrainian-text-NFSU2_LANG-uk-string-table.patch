diff --git a/src/apple/font_uk.m b/src/apple/font_uk.m
new file mode 100644
index 0000000..3bf0429
--- /dev/null
+++ b/src/apple/font_uk.m
@@ -0,0 +1,601 @@
+/**
+ * Cyrillic glyphs for the Ukrainian text (Deadware, NFSU2_LANG=uk).
+ *
+ * The game's text fonts (FNTX in chunk 0x00030201) hold ASCII + Latin-1 and look
+ * glyphs up by code (bytes >= 0xA0 are their own code). The Ukrainian strings
+ * (text_patch.c) are cp1251, so a Cyrillic letter arrives as a Latin-1 code:
+ * А = 0xC0 (À). As the pack is read, every text font's glyph table is rebuilt
+ * with the same number of records, still sorted: ASCII and the symbols the
+ * text uses keep their records, the cp1251 codes get Cyrillic ones.
+ *   - lookalikes (А В Е К М Н О Р С Т Х І а е о р с у х і Ї ї) reuse the Latin
+ *     glyph's place in the atlas;
+ *   - the rest are drawn with CoreText from a macOS system font (Arial for
+ *     font_arial, PT Sans Narrow slanted for the Conduit fonts) sized to
+ *     the font's own cap height, packed into the atlas space no kept glyph
+ *     uses, and painted into the atlas by a texture provider when the game
+ *     uploads it (matched by size and by glyph coverage).
+ * Nothing from those system fonts is shipped: they are rendered on the
+ * player's Mac. Log: "[UA] font NAME: ..., missing N" (N must be 0).
+ */
+#import <CoreGraphics/CoreGraphics.h>
+#import <CoreText/CoreText.h>
+#import <Foundation/Foundation.h>
+
+#include <math.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "apple_textures.h"
+
+int nfsu2_text_uk_active(void);
+void nfsu2_text_uk_each(void (*fn)(const char *s, void *ctx), void *ctx);
+
+#define FONT_CHUNK 0x00030201u
+#define MAX_FONTS 8
+#define MAX_REC 256
+
+typedef struct {
+    uint16_t code;
+    uint8_t w, h;
+    uint16_t u, v;
+    uint8_t zero;
+    int8_t xoff;
+    uint8_t yoff, kc;
+    uint16_t ki, adv;
+} Rec;                          /* 16 bytes, as in the pack */
+
+/* A glyph painted into the atlas. Normal fonts: alpha is w x h at (u, v). Late fonts (patched
+   in guest RAM after the game cached the glyph rects): the rect (u, v, w, h) is an original
+   Latin-1 glyph's, and the source (alpha sw x sh, or the atlas at su, sv when alpha is NULL)
+   is fitted into it from row dy. */
+typedef struct { uint16_t u, v; uint8_t w, h; uint8_t *alpha; uint16_t su, sv; uint8_t sw, sh; int8_t dy, fit; } Drawn;
+
+typedef struct {
+    char name[64];
+    uint64_t sig;               /* FNV-1a of the original record table */
+    uint32_t n, aw, ah;
+    Rec orig[MAX_REC], out[MAX_REC];
+    uint8_t *keep;              /* aw*ah: 1 where a kept glyph lives */
+    int late;                   /* patched in guest RAM: glyph rects stay */
+    Drawn drawn[MAX_REC];
+    int ndrawn;
+} Font;
+
+static Font s_font[MAX_FONTS];
+static int s_nfont;
+static pthread_mutex_t s_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint8_t s_used[256];     /* bytes the Ukrainian text uses */
+static NSMutableSet<NSNumber *> *s_not_atlas;
+static NSMutableDictionary<NSNumber *, NSData *> *s_atlases;   /* texture hash -> composed atlas */
+
+static uint64_t fnv(const void *p, size_t n)
+{
+    const uint8_t *b = p;
+    uint64_t h = 0xcbf29ce484222325ull;
+    while (n--) h = (h ^ *b++) * 0x100000001b3ull;
+    return h;
+}
+
+static void mark_used(const char *s, void *ctx)
+{
+    (void)ctx;
+    for (; *s; s++) s_used[(uint8_t)*s] = 1;
+}
+
+/* Text byte -> the character the Ukrainian text means by it (0 = none): cp1251, except that
+   build_uk.py writes І і Ч « as A2 A3 A7 B5 -- codes the dialog font (tt21i, patched late, no new
+   records possible) has, where cp1251's B2 B3 D7 AB are missing from it. */
+static unichar cp1251(uint8_t b)
+{
+    static const unichar hi[64] = {
+        0x00A0, 0x040E, 0x0406, 0x0456, 0x00A4, 0x0490, 0x00A6, 0x0427, 0x0401, 0x00A9, 0x0404, 0x00AB,
+        0x00AC, 0x00AD, 0x00AE, 0x0407, 0x00B0, 0x00B1, 0x0406, 0x0456, 0x0491, 0x00AB, 0x00B6, 0x00B7,
+        0x0451, 0x2116, 0x0454, 0x00BB, 0x0458, 0x0405, 0x0455, 0x0457,
+    };
+    if (b < 0xA0) return b < 0x80 ? b : 0;
+    if (b < 0xC0) return hi[b - 0xA0];
+    return (unichar)(0x0410 + (b - 0xC0));
+}
+
+/* Cyrillic letters drawn by a Latin glyph of the same font. */
+static uint16_t lookalike(unichar c)
+{
+    switch (c) {
+    case 0x0410: return 'A'; case 0x0412: return 'B'; case 0x0415: return 'E'; case 0x041A: return 'K';
+    case 0x041C: return 'M'; case 0x041D: return 'H'; case 0x041E: return 'O'; case 0x0420: return 'P';
+    case 0x0421: return 'C'; case 0x0422: return 'T'; case 0x0425: return 'X'; case 0x0406: return 'I';
+    case 0x0430: return 'a'; case 0x0435: return 'e'; case 0x043E: return 'o'; case 0x0440: return 'p';
+    case 0x0441: return 'c'; case 0x0443: return 'y'; case 0x0445: return 'x'; case 0x0456: return 'i';
+    case 0x0407: return 0xCF; case 0x0457: return 0xEF;     /* Ï ï */
+    }
+    return 0;
+}
+
+static const Rec *find(const Rec *r, uint32_t n, uint16_t code)
+{
+    uint32_t i;
+    for (i = 0; i < n; i++) if (r[i].code == code) return &r[i];
+    return NULL;
+}
+
+static int cmp_rec(const void *a, const void *b)
+{
+    return (int)((const Rec *)a)->code - (int)((const Rec *)b)->code;
+}
+
+static CTFontRef make_font(const char *name, const Rec *H, CGFloat *base_fix)
+{
+    /* System fonts with Cyrillic (Avenir Next Condensed has none): PT Sans Narrow, slanted
+       like the game's Conduit italics. */
+    int ital = strstr(name, "conduit") != NULL;
+    const char *ps = strstr(name, "38bi") ? "PTSans-NarrowBold" : ital ? "PTSans-Narrow" : "ArialMT";
+    CFStringRef n = CFStringCreateWithCString(NULL, ps, kCFStringEncodingASCII);
+    CTFontRef f1 = CTFontCreateWithName(n, 100, NULL), f;
+    CGFloat cap = CTFontGetCapHeight(f1) / 100, size, sx = 1;
+    CGGlyph g;
+    UniChar ch = 'H';
+    CGSize adv;
+    size = cap > 0 ? H->h / cap : H->h * 1.4;
+    f = CTFontCreateWithName(n, size, NULL);
+    if (CTFontGetGlyphsForCharacters(f, &ch, &g, 1)) {
+        CTFontGetAdvancesForGlyphs(f, kCTFontOrientationHorizontal, &g, &adv, 1);
+        if (adv.width > 0) sx = H->adv / adv.width;
+        if (sx < 0.6) sx = 0.6;
+        if (sx > 1.4) sx = 1.4;
+    }
+    CFRelease(f);
+    CGAffineTransform m = CGAffineTransformMake(sx, 0, ital ? 0.21 : 0, 1, 0, 0);
+    f = CTFontCreateWithName(n, size, &m);
+    *base_fix = 0;
+    CFRelease(f1);
+    CFRelease(n);
+    return f;
+}
+
+/* Render one character: alpha bitmap + metrics in the font's terms. */
+static int render(CTFontRef f, unichar c, int baseline, Rec *r, uint8_t **alpha)
+{
+    CGGlyph g;
+    CGSize adv;
+    CGRect bb;
+    if (!CTFontGetGlyphsForCharacters(f, &c, &g, 1)) return 0;
+    bb = CTFontGetBoundingRectsForGlyphs(f, kCTFontOrientationHorizontal, &g, NULL, 1);
+    CTFontGetAdvancesForGlyphs(f, kCTFontOrientationHorizontal, &g, &adv, 1);
+    int x0 = (int)floor(bb.origin.x), x1 = (int)ceil(bb.origin.x + bb.size.width);
+    int y0 = (int)floor(bb.origin.y), y1 = (int)ceil(bb.origin.y + bb.size.height);
+    int w = x1 - x0 + 2, h = y1 - y0 + 2;           /* 1 px of AA room each side */
+    if (w < 1 || h < 1 || w > 255 || h > 255) return 0;
+    uint8_t *a = calloc((size_t)w * h, 1);
+    CGContextRef cx = CGBitmapContextCreate(a, w, h, 8, w, NULL, (CGBitmapInfo)kCGImageAlphaOnly);
+    if (!cx) { free(a); return 0; }
+    CGContextSetShouldAntialias(cx, true);
+    CGContextSetShouldSmoothFonts(cx, false);
+    CGPoint pos = CGPointMake(1 - x0, 1 - y0);
+    CTFontDrawGlyphs(f, &g, &pos, 1, cx);
+    CGContextRelease(cx);
+    int top = baseline - (y1 + 1);                  /* rows above the bitmap's top */
+    int skip = 0;
+    if (top < 0) { skip = -top; top = 0; }          /* crop what rises above the line */
+    if (skip >= h) { free(a); return 0; }
+    if (skip) memmove(a, a + (size_t)skip * w, (size_t)(h - skip) * w);
+    h -= skip;
+    /* Trim to the ink (the atlas place keeps a 1 px clear ring around it). */
+    int ix0 = w, ix1 = -1, iy0 = h, iy1 = -1;
+    for (int yy = 0; yy < h; yy++)
+        for (int xx = 0; xx < w; xx++)
+            if (a[yy * w + xx]) {
+                if (xx < ix0) ix0 = xx; if (xx > ix1) ix1 = xx;
+                if (yy < iy0) iy0 = yy; if (yy > iy1) iy1 = yy;
+            }
+    if (ix1 < 0) { free(a); return 0; }
+    int tw = ix1 - ix0 + 1, th = iy1 - iy0 + 1;
+    for (int yy = 0; yy < th; yy++) memmove(a + yy * tw, a + (iy0 + yy) * w + ix0, tw);
+    x0 += ix0; top += iy0; w = tw; h = th;
+    memset(r, 0, sizeof *r);
+    r->code = 0;
+    r->w = (uint8_t)w; r->h = (uint8_t)h;
+    r->xoff = (int8_t)(x0 - 1);
+    r->yoff = (uint8_t)(top > 255 ? 255 : top);
+    r->adv = (uint16_t)lround(adv.width);
+    *alpha = a;
+    return 1;
+}
+
+/* First free wxh place in occ (1 = taken), via a summed-area table. */
+static int place(const uint8_t *occ, uint32_t aw, uint32_t ah, int w, int h, int *pu, int *pv)
+{
+    uint32_t *sat = calloc((size_t)(aw + 1) * (ah + 1), 4);
+    int x, y, ok = 0;
+    for (y = 0; y < (int)ah; y++)
+        for (x = 0; x < (int)aw; x++)
+            sat[(y + 1) * (aw + 1) + x + 1] = occ[y * aw + x] + sat[y * (aw + 1) + x + 1]
+                                              + sat[(y + 1) * (aw + 1) + x] - sat[y * (aw + 1) + x];
+    int W = w, Hh = h;   /* every placed glyph is marked with a 1 px ring */
+    for (y = 0; y + Hh <= (int)ah && !ok; y++)
+        for (x = 0; x + W <= (int)aw; x++) {
+            uint32_t s = sat[(y + Hh) * (aw + 1) + x + W] - sat[y * (aw + 1) + x + W]
+                       - sat[(y + Hh) * (aw + 1) + x] + sat[y * (aw + 1) + x];
+            if (!s) { *pu = x; *pv = y; ok = 1; break; }
+        }
+    free(sat);
+    return ok;
+}
+
+static void mark(uint8_t *occ, uint32_t aw, uint32_t ah, int u, int v, int w, int h, int pad)
+{
+    int x, y;
+    for (y = v - pad; y < v + h + pad; y++)
+        for (x = u - pad; x < u + w + pad; x++)
+            if (x >= 0 && y >= 0 && x < (int)aw && y < (int)ah) occ[y * aw + x] = 1;
+}
+
+static int by_height(const void *a, const void *b)
+{
+    return (int)((const Rec *)b)->h - (int)((const Rec *)a)->h;
+}
+
+/* Build the Ukrainian record table for one font (f->orig filled). */
+static void build_late(Font *f)
+{
+    uint32_t n = f->n;
+    const Rec *H = find(f->orig, n, 'H');
+    int b, missing = 0, looks = 0, drawn = 0;
+    memcpy(f->out, f->orig, sizeof(Rec) * n);
+    f->keep = malloc((size_t)f->aw * f->ah);
+    memset(f->keep, 1, (size_t)f->aw * f->ah);
+    if (!H) { fprintf(stderr, "[UA] font %s: no 'H', left as is\n", f->name); return; }
+    int baseline = H->yoff + H->h;
+    CGFloat fix;
+    CTFontRef ct = make_font(f->name, H, &fix);
+    for (b = 0xA0; b < 256; b++) {
+        if (!s_used[b] && b != 0xA5 && b != 0xB4) continue;
+        unichar c = cp1251((uint8_t)b);
+        if (c == b) continue;                           /* © « ® »: the font's own */
+        const Rec *R = find(f->orig, n, (uint16_t)b);
+        if (!R || R->w < 2 || R->h < 2 || R->u + R->w > f->aw || R->v + R->h > f->ah) {
+            if (s_used[b]) missing++;
+            continue;
+        }
+        Drawn d = { R->u, R->v, R->w, R->h, NULL, 0, 0, 0, 0, 0, 1 };
+        uint16_t lat = lookalike(c);
+        const Rec *L = lat ? find(f->orig, n, lat) : NULL;
+        Rec r;
+        if (L) {
+            d.su = L->u; d.sv = L->v; d.sw = L->w; d.sh = L->h;
+            d.dy = (int8_t)((int)L->yoff - (int)R->yoff);
+            looks++;
+        } else if (render(ct, c, baseline, &r, &d.alpha)) {
+            d.sw = r.w; d.sh = r.h;
+            d.dy = (int8_t)((int)r.yoff - (int)R->yoff);
+            drawn++;
+        } else { if (s_used[b]) missing++; continue; }
+        for (int y = R->v; y < R->v + R->h; y++)          /* the Latin-1 glyph goes */
+            memset(f->keep + (size_t)y * f->aw + R->u, 0, R->w);
+        f->drawn[f->ndrawn++] = d;
+    }
+    CFRelease(ct);
+    fprintf(stderr, "[UA] font %s (late): %u glyphs, %d lookalike, %d drawn into Latin-1 rects, missing %d\n",
+            f->name, n, looks, drawn, missing);
+}
+
+static void build(Font *f)
+{
+    if (f->late) { build_late(f); return; }
+    uint32_t n = f->n, i, nout = 0;
+    const Rec *H = find(f->orig, n, 'H');
+    uint8_t want[256] = {0};
+    int b, missing = 0, looks = 0, drawn = 0, kept_sym = 0;
+    if (!H) { fprintf(stderr, "[UA] font %s: no 'H', left as is\n", f->name); memcpy(f->out, f->orig, sizeof(Rec) * n); return; }
+    int baseline = H->yoff + H->h;
+    f->keep = calloc((size_t)f->aw * f->ah, 1);
+
+    /* 1. ASCII stays. */
+    for (i = 0; i < n; i++)
+        if (f->orig[i].code < 0x80) f->out[nout++] = f->orig[i];
+    /* 2. Codes >= 0x80 the text uses. */
+    for (b = 0x80; b < 256; b++) if (s_used[b]) want[b] = 1;
+    want[0xA5] = want[0xB4] = 1;    /* Ґ ґ even if unused */
+    Rec newr[128];
+    uint8_t *newa[128];
+    int nnew = 0;
+    for (b = 0xA0; b < 256 && nout + nnew < n; b++) {
+        if (!want[b]) continue;
+        unichar c = cp1251((uint8_t)b);
+        const Rec *same = c == b ? find(f->orig, n, (uint16_t)b) : NULL;   /* © « ® » */
+        if (same) { f->out[nout++] = *same; kept_sym++; continue; }
+        uint16_t lat = lookalike(c);
+        const Rec *L = lat ? find(f->orig, n, lat) : NULL;
+        if (L) {
+            Rec r = *L;
+            r.code = (uint16_t)b; r.kc = 0; r.ki = 0;
+            f->out[nout++] = r;
+            looks++;
+            continue;
+        }
+        newr[nnew].code = (uint16_t)b;      /* drawn below */
+        newa[nnew] = NULL;
+        nnew++;
+    }
+    /* 3. Fill the rest with the other originals (™, quotes...), codes not taken. */
+    for (i = 0; i < n && nout + nnew < n; i++) {
+        uint16_t c = f->orig[i].code;
+        if (c < 0x80 || (c < 256 && want[c])) continue;
+        if (c >= 0x80 && c < 0x100) continue;   /* Latin-1 letters: their atlas space goes to Cyrillic */
+        f->out[nout++] = f->orig[i];
+    }
+    /* Kept glyphs' atlas space. */
+    for (i = 0; i < nout; i++)
+        mark(f->keep, f->aw, f->ah, f->out[i].u, f->out[i].v, f->out[i].w, f->out[i].h, 0);
+    uint8_t *occ = malloc((size_t)f->aw * f->ah);
+    memcpy(occ, f->keep, (size_t)f->aw * f->ah);
+    for (i = 0; i < nout; i++)
+        mark(occ, f->aw, f->ah, f->out[i].u, f->out[i].v, f->out[i].w, f->out[i].h, 1);
+
+    /* 4. Draw the rest with CoreText. */
+    CGFloat fix;
+    CTFontRef ct = make_font(f->name, H, &fix);
+    for (int k = 0; k < nnew; k++) {
+        uint16_t code = newr[k].code;
+        if (!render(ct, cp1251((uint8_t)code), baseline, &newr[k], &newa[k])) { newr[k].h = 0; newa[k] = NULL; }
+        newr[k].code = code;
+        newr[k].ki = (uint16_t)k;   /* temp: index into newa */
+    }
+    CFRelease(ct);
+    qsort(newr, nnew, sizeof newr[0], by_height);
+    for (int k = 0; k < nnew; k++) {
+        Rec r = newr[k];
+        uint8_t *a = newa[r.ki];
+        int u, v;
+        if (!a || !place(occ, f->aw, f->ah, r.w, r.h, &u, &v)) {
+            if (getenv("NFSU2_UA_DEBUG")) fprintf(stderr, "[UA]  %02X %s %dx%d atlas %ux%u\n", r.code, a ? "no room" : "render failed", r.w, r.h, f->aw, f->ah);
+            free(a); missing++; continue; }
+        mark(occ, f->aw, f->ah, u, v, r.w, r.h, 1);
+        mark(f->keep, f->aw, f->ah, u, v, r.w, r.h, 0);
+        r.u = (uint16_t)u; r.v = (uint16_t)v; r.ki = 0; r.kc = 0;
+        f->out[nout++] = r;
+        f->drawn[f->ndrawn++] = (Drawn){ (uint16_t)u, (uint16_t)v, r.w, r.h, a };
+        drawn++;
+    }
+    free(occ);
+    /* Keep the count: pad with spare originals if anything failed. */
+    for (i = 0; i < n && nout < n; i++) {
+        uint16_t c = f->orig[i].code;
+        if (!find(f->out, nout, c) && !(c < 256 && want[c])) f->out[nout++] = f->orig[i];
+    }
+    while (nout < n) { f->out[nout] = f->out[nout - 1]; f->out[nout].code = (uint16_t)(0xF000 + nout); nout++; }
+    qsort(f->out, n, sizeof(Rec), cmp_rec);
+    /* Missing = a used byte with no record. */
+    for (b = 0x20; b < 256; b++) {
+        if (!s_used[b] || b == 0x82 || (b >= 0x80 && b < 0xA0)) continue;
+        if (!find(f->out, n, (uint16_t)b)) missing++;
+    }
+    if (s_used[0x82] && !find(f->out, n, 8482)) missing++;
+    fprintf(stderr, "[UA] font %s: %u glyphs, %d lookalike, %d drawn, %d symbols kept, missing %d\n",
+            f->name, n, looks, drawn, kept_sym, missing);
+}
+
+static void patch_font(uint8_t *chunk, uint8_t *fntx, size_t avail, int late)
+{
+    uint32_t tot, gt, n, aw, ah;
+    float iw;
+    char name[64];
+    memcpy(&tot, fntx + 4, 4);
+    memcpy(&gt, fntx + 0x14, 4);
+    n = (uint32_t)fntx[10] | (uint32_t)fntx[11] << 8;
+    float ih;
+    memcpy(&iw, fntx + 0x40, 4);            /* 1/width, 1/height of the atlas */
+    memcpy(&ih, fntx + 0x44, 4);
+    if (getenv("NFSU2_UA_DEBUG"))
+        fprintf(stderr, "[UA]  font %.40s: n %u, table %u, avail %zu, atlas %.0fx%.0f\n", (const char *)chunk + 8,
+                n, gt, avail, iw > 0 ? 1 / iw : 0, ih > 0 ? 1 / ih : 0);
+    if (n < 150 || n > MAX_REC || gt + 16ull * n > avail || !(iw > 0) || !(ih > 0)) return;
+    aw = (uint32_t)lroundf(1 / iw);
+    ah = (uint32_t)lroundf(1 / ih);
+    if (aw < 16 || aw > 2048 || ah < 16 || ah > 2048) return;
+    memcpy(name, chunk + 8, sizeof name);
+    name[sizeof name - 1] = 0;
+    if (strstr(name, "chinese") || strstr(name, "japanese") || strstr(name, "korean") || strstr(name, "thai"))
+        return;
+    uint8_t *tab = fntx + gt;
+    uint64_t sig = fnv(tab, 16ull * n);
+    Font *f = NULL;
+    int i;
+    pthread_mutex_lock(&s_mu);
+    for (i = 0; i < s_nfont; i++)
+        if (s_font[i].sig == sig && !strcmp(s_font[i].name, name)) { f = &s_font[i]; break; }
+        else if (!memcmp(s_font[i].out, tab, 16ull * n) && s_font[i].n == n) { pthread_mutex_unlock(&s_mu); return; }
+    if (!f && s_nfont < MAX_FONTS) {
+        f = &s_font[s_nfont];
+        memset(f, 0, sizeof *f);
+        strcpy(f->name, name);
+        f->sig = sig; f->n = n; f->aw = aw; f->ah = ah; f->late = late;
+        memcpy(f->orig, tab, 16ull * n);
+        build(f);
+        s_nfont++;
+    }
+    if (f) memcpy(tab, f->out, 16ull * n);
+    pthread_mutex_unlock(&s_mu);
+}
+
+/* text_patch.c's read hook, Ukrainian mode: rebuild every text font in buf. */
+void nfsu2_font_uk_scan(void *buf, size_t len)
+{
+    uint8_t *b = buf;
+    size_t i;
+    if (len < 0x300) return;
+    for (i = 0; i + 0x60 <= len; i++) {
+        uint8_t *p = memmem(b + i, len - i, "FNTX", 4);
+        if (!p) break;
+        i = (size_t)(p - b);
+        if (i < 0x208) {
+            if (getenv("NFSU2_UA_DEBUG")) fprintf(stderr, "[UA]  FNTX at %zu of %zu: chunk head in an earlier read\n", i, len);
+            continue;
+        }
+        if (i + 0x60 > len) break;
+        uint32_t id;
+        memcpy(&id, b + i - 0x208, 4);
+        if (getenv("NFSU2_UA_DEBUG")) fprintf(stderr, "[UA]  FNTX at %zu of %zu, id %08x, name %.40s\n", i, len, id, (const char *)b + i - 0x200);
+        if (id != FONT_CHUNK) continue;
+        patch_font(b + i - 0x208, b + i, len - i, 0);
+    }
+}
+
+/* Fonts the read hook never sees (loaded compressed, or split over reads) are patched in guest
+   RAM: their atlas is uploaded after the font chunk is in memory, so a new atlas-sized UI texture
+   with no matching font triggers one pass over RAM for unpatched FNTX headers (~5 ms). */
+extern ptrdiff_t g_xbox_mem_offset;
+extern size_t g_xbox_total_ram;
+
+static unsigned s_scans;
+static double s_scan_ms;
+
+static void scan_guest(void)
+{
+    CFAbsoluteTime t0 = CFAbsoluteTimeGetCurrent();
+    uint8_t *base = (uint8_t *)(uintptr_t)g_xbox_mem_offset;
+    size_t len = g_xbox_total_ram, i;
+    uint32_t tag, id;
+    memcpy(&tag, "FNTX", 4);
+    for (i = 0x10000; i + 0x60 <= len; i += 4) {
+        if (*(const uint32_t *)(base + i) != tag) continue;
+        memcpy(&id, base + i - 0x208, 4);
+        if (id != FONT_CHUNK) continue;
+        patch_font(base + i - 0x208, base + i, len - i, 1);
+    }
+    s_scans++;
+    s_scan_ms += (CFAbsoluteTimeGetCurrent() - t0) * 1000;
+    if (!(s_scans & (s_scans - 1)))
+        fprintf(stderr, "[UA] guest font scans: %u, %.0f ms in all\n", s_scans, s_scan_ms);
+}
+
+/* Texture provider: the font atlases get the drawn glyphs. */
+/* How well a texture matches a font's original atlas: every glyph rect inked (>= 98%)
+   and nothing outside the rects (>= 99% of those pixels clear). Returns 0 or a score. */
+static uint32_t atlas_score(const Font *f, const Nv2aTexInfo *ti, uint32_t *phit, uint32_t *ptested)
+{
+    uint32_t r, hit = 0, tested = 0, W = ti->w;
+    uint8_t *in = calloc((size_t)f->aw * f->ah, 1);
+    for (r = 0; r < f->n; r++) {
+        const Rec *o = &f->orig[r];
+        if (o->u + o->w > f->aw || o->v + o->h > f->ah) continue;
+        mark(in, f->aw, f->ah, o->u, o->v, o->w, o->h, 1);
+        if (o->w < 3 || o->h < 3) continue;
+        int x, y, ink = 0;
+        for (y = o->v; y < o->v + o->h && !ink; y++)
+            for (x = o->u; x < o->u + o->w; x++)
+                if (ti->argb[y * W + x] >> 24 > 0x20) { ink = 1; break; }
+        tested++;
+        hit += (uint32_t)ink;
+    }
+    uint32_t out = 0, clear = 0;
+    for (r = 0; r < f->aw * f->ah; r++) {
+        if (in[r]) continue;
+        out++;
+        clear += (ti->argb[(r / f->aw) * W + r % f->aw] >> 24) <= 0x08;
+    }
+    free(in);
+    if (getenv("NFSU2_UA_DEBUG"))
+        fprintf(stderr, "[UA]  %016llx vs %s: inked %u/%u, clear %u/%u\n", (unsigned long long)ti->hash, f->name, hit, tested, clear, out);
+    *phit = hit; *ptested = tested;
+    if (!tested || hit * 100 < tested * 98 || clear * 100 < out * 99) return 0;
+    return 1 + (uint32_t)((uint64_t)clear * 1000000 / (out ? out : 1)) + hit * 1000000 / tested;
+}
+
+/* Late fonts: fit the source into the rect (bilinear; shrunk to fit, never enlarged). */
+static void fit_glyph(const Drawn *g, const uint32_t *atlas, uint32_t W, uint32_t *px, uint32_t rgb)
+{
+    int sw = g->sw, sh = g->sh, x, y;
+    if (sw < 1 || sh < 1) return;
+    float *src = malloc(sizeof(float) * sw * sh);
+    for (y = 0; y < sh; y++)
+        for (x = 0; x < sw; x++)
+            src[y * sw + x] = g->alpha ? g->alpha[y * sw + x] : (float)(atlas[(g->sv + y) * W + g->su + x] >> 24);
+    int dy = g->dy < 0 ? 0 : g->dy;
+    if (dy > g->h - 2) dy = g->h - 2;
+    int th = sh < g->h - dy ? sh : g->h - dy, tw = sw < g->w ? sw : g->w;
+    if (th < 1 || tw < 1) { free(src); return; }
+    for (y = 0; y < th; y++)
+        for (x = 0; x < tw; x++) {
+            float fx = (x + 0.5f) * sw / tw - 0.5f, fy = (y + 0.5f) * sh / th - 0.5f;
+            int x0 = (int)floorf(fx), y0 = (int)floorf(fy);
+            float ax = fx - x0, ay = fy - y0, v = 0;
+            for (int j = 0; j < 2; j++)
+                for (int i = 0; i < 2; i++) {
+                    int xx = x0 + i, yy = y0 + j;
+                    if (xx < 0 || yy < 0 || xx >= sw || yy >= sh) continue;
+                    v += src[yy * sw + xx] * (i ? ax : 1 - ax) * (j ? ay : 1 - ay);
+                }
+            uint32_t a = v > 255 ? 255 : (uint32_t)lroundf(v);
+            px[(g->v + dy + y) * W + g->u + (g->w - tw) / 2 + x] = a << 24 | rgb;   /* centred */
+        }
+    free(src);
+}
+
+static const uint32_t *atlas_provide(const Nv2aTexInfo *ti, uint32_t *k)
+{
+    const uint32_t *ret = NULL;
+    int i, best = -1;
+    uint32_t best_score = 0, bhit = 0, btested = 0;
+    pthread_mutex_lock(&s_mu);
+    NSData *have = s_atlases[@(ti->hash)];
+    if (have) ret = have.bytes;
+    int scanned = 0;
+    if (!ret && ![s_not_atlas containsObject:@(ti->hash)]) {
+    again:
+        for (i = 0; i < s_nfont; i++) {
+            Font *f = &s_font[i];
+            uint32_t hit, tested, sc;
+            /* The texture may be taller than the glyphs reach (rows below stay as they are). */
+            if (!f->ndrawn || ti->w != f->aw || ti->h < f->ah) continue;
+            sc = atlas_score(f, ti, &hit, &tested);
+            if (sc > best_score) { best_score = sc; best = i; bhit = hit; btested = tested; }
+        }
+        if (best >= 0) {
+            Font *f = &s_font[best];
+            uint32_t r, n = ti->w * ti->h, rgb = 0xFFFFFF, top = 0;
+            for (r = 0; r < f->aw * f->ah; r++)
+                if ((ti->argb[r] >> 24) > top) { top = ti->argb[r] >> 24; rgb = ti->argb[r] & 0xFFFFFF; }
+            uint32_t *px = malloc((size_t)n * 4);
+            memcpy(px, ti->argb, (size_t)n * 4);
+            for (r = 0; r < f->aw * f->ah; r++)
+                if (!f->keep[r]) px[r] = rgb;              /* freed space: transparent */
+            for (int d = 0; d < f->ndrawn; d++) {
+                Drawn *g = &f->drawn[d];
+                if (g->fit) { fit_glyph(g, ti->argb, ti->w, px, rgb); continue; }
+                for (int y = 0; y < g->h; y++)
+                    for (int x = 0; x < g->w; x++)
+                        px[(g->v + y) * ti->w + g->u + x] = (uint32_t)g->alpha[y * g->w + x] << 24 | rgb;
+            }
+            /* Kept for good: the renderer may still hold an earlier one. */
+            s_atlases[@(ti->hash)] = [NSData dataWithBytesNoCopy:px length:(size_t)n * 4 freeWhenDone:YES];
+            fprintf(stderr, "[UA] atlas %016llx %ux%u = %s (%u of %u glyph rects inked), %d glyphs drawn in\n",
+                    (unsigned long long)ti->hash, ti->w, ti->h, f->name, bhit, btested, f->ndrawn);
+            ret = px;
+        } else if (!scanned && ti->flat && ti->w >= 128 && ti->h >= 64 && ti->w <= 1024 && ti->h <= 1024
+                   && !(ti->w & (ti->w - 1)) && !(ti->h & (ti->h - 1))) {
+            int before = s_nfont;
+            scanned = 1;
+            pthread_mutex_unlock(&s_mu);
+            scan_guest();
+            pthread_mutex_lock(&s_mu);
+            if (s_nfont != before) goto again;
+            [s_not_atlas addObject:@(ti->hash)];
+        }
+    }
+    pthread_mutex_unlock(&s_mu);
+    if (ret) *k = 1;
+    return ret;
+}
+
+void nfsu2_font_uk_init(void)
+{
+    if (!nfsu2_text_uk_active()) return;
+    nfsu2_text_uk_each(mark_used, NULL);
+    s_used[0] = 0;
+    s_not_atlas = [NSMutableSet new];
+    s_atlases = [NSMutableDictionary new];
+    nfsu2_tex_add_provider_first(atlas_provide);
+    fprintf(stderr, "[UA] Ukrainian text: fonts get Cyrillic glyphs\n");
+}
