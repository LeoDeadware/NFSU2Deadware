+/* Even game steps (Deadware, owner 2026-11-09: walls, signs and trees move
+ * back and forth while driving). The race/open-world loop sub_0018A8C0 feeds
+ * sub_001890C0 the loop's own CPU-timer period (sub_0004ADA0/sub_0004ADD0 x
+ * 0x3409B8), not vblanks: on the Xbox the loop is paced by the flips, here by
+ * guest-lock and fence waits, so at an even 60 flips/s the world advanced by
+ * 60, 61..76 or ~120 ticks (1/3600 s) a frame -- static geometry jumped against
+ * the camera -- and the 1/60 floor (0x428EE8) lifted short loops, game time
+ * ran 12% fast. Each flip now measures the display interval in whole vblanks
+ * (wall time, accumulated so sampling jitter rounds away) and sets the floor
+ * and the cap (0x3A4C64, x 1/60 s; read only by sub_001890C0) both to it:
+ * every step is exactly that many vblanks (60 ticks at 60 fps, 30 at 120,
+ * 120 at 30) whatever the loop measured. The front end's vblank loop
+ * sub_0018A6A0 gets the same value it counted itself. NFSU2_STEP_LOCK=0 off. */
+static int step_lock_on(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("NFSU2_STEP_LOCK");
+        v = !(e && *e == '0');
+        fprintf(stderr, "[fps] game step locked to the display's vblanks: %s\n", v ? "on" : "off (NFSU2_STEP_LOCK=0)");
+    }
+    return v;
+}
+static void step_lock_flip(void)
+{
+    static uint64_t prev;
+    static double acc;
+    static unsigned last_d;
+    struct timespec ts;
+    uint64_t now;
+    double period = fps_cap_120() ? 1.0 / 119.88 : 1.0 / 59.94;
+    unsigned d;
+    if (!step_lock_on())
+        return;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    now = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    if (!prev) {
+        prev = now;
+        return;
+    }
+    acc += (now - prev) / 1e9;
+    prev = now;
+    d = (unsigned)(acc / period + 0.5);
+    if (d < 1u)
+        d = 1u;
+    if (d > 6u * (fps_cap_120() ? 2u : 1u)) {   /* a stall: the original's 100 ms cap */
+        d = 6u * (fps_cap_120() ? 2u : 1u);
+        acc = d * period;
+    }
+    acc -= d * period;
+    if (acc < -period) acc = -period;            /* loop faster than the display: no debt */
+    if (acc > period) acc = period;
+    if (d != last_d) {
+        /* step = cap x (1/60 or PAL 0.02); floor computed the same way so
+         * min(max(t, floor), cap) is exactly it. */
+        float unit = MEM32(0x3A4C50) ? MEMF(0x343EFC) : MEMF(0x341750);
+        float mul = fps_cap_120() ? (float)d * 0.5f : (float)d;   /* x 1/60 s */
+        MEMF(0x3A4C64) = mul;
+        MEMF(0x428EE8) = (float)((double)mul * (double)unit);
+        last_d = d;
+    } else if (MEMF(0x428EE8) != (float)((double)MEMF(0x3A4C64) *
+               (double)(MEM32(0x3A4C50) ? MEMF(0x343EFC) : MEMF(0x341750)))) {
+        last_d = 0;                               /* the title reset its floor: redo next flip */
+    }
+}
