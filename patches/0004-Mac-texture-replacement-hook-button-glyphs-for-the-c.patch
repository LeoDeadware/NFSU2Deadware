+    t->rk = 0;
+    if (!nv2a_tex_replace_hook || t->face || (t->pitch && t->color != 0x0B))
+        return 0;
+    if ((size_t)w * h > s_decode_cap) {
+        free(s_decode);
+        s_decode_cap = (size_t)w * h;
+        s_decode = (uint32_t *)malloc(s_decode_cap * 4);
+    }
+    if (!s_decode)
+        return 0;
