diff --git a/xboxrecomp/src/kernel/nv2a_backend.h b/xboxrecomp/src/kernel/nv2a_backend.h
index 8998673..5017881 100644
--- a/xboxrecomp/src/kernel/nv2a_backend.h
+++ b/xboxrecomp/src/kernel/nv2a_backend.h
@@ -189,6 +189,21 @@ void nv2a_backend_register(const Nv2aBackend *backend);
  * Returns 0 if the format is not supported. */
 int nv2a_backend_decode_texture(const Nv2aTexture *tex, uint32_t *argb_out);
 
+/* Texture replacement (title hook; Metal back end). Called when a swizzled
+ * or DXT 2D texture is uploaded. `hash` is a 64-bit FNV-1a of all its guest
+ * bytes (palette included), `argb` its decoded w x h pixels (A8R8G8B8).
+ * Return w*k x h*k A8R8G8B8 pixels (k >= 1, set *k) to draw instead, or
+ * NULL to keep the original. The pixels must stay valid until the next
+ * call. Bump nv2a_tex_replace_gen to have every texture asked again (e.g.
+ * when the pad family changes). */
+typedef struct {
+    uint32_t color, w, h, bytes;
+    uint64_t hash;
+    const uint32_t *argb;
+} Nv2aTexInfo;
+extern const uint32_t *(*nv2a_tex_replace_hook)(const Nv2aTexInfo *ti, uint32_t *k);
+extern volatile uint32_t nv2a_tex_replace_gen;
+
 /* Where BACK_END_WRITE_SEMAPHORE_RELEASE (0x1D70) values land: the guest VA
  * of the semaphore the title reads GPU progress from (for XDK D3D, the
  * pointer at device+0x30). The executor writes each release there once it
diff --git a/xboxrecomp/src/nv2a_metal/nv2a_metal.m b/xboxrecomp/src/nv2a_metal/nv2a_metal.m
index 94677d7..389e379 100644
--- a/xboxrecomp/src/nv2a_metal/nv2a_metal.m
+++ b/xboxrecomp/src/nv2a_metal/nv2a_metal.m
@@ -548,8 +548,12 @@ static void surf_reset(MtSurf *s)
     __strong id<MTLTexture> tex;
     MTLPixelFormat fmt;
     uint32_t used, checked;
+    uint32_t rgen, rk;          /* replacement generation asked, scale (0 = original) */
 } MtTex;
 
+const uint32_t *(*nv2a_tex_replace_hook)(const Nv2aTexInfo *ti, uint32_t *k);
+volatile uint32_t nv2a_tex_replace_gen = 1;
+
 #define MTL_MAX_TEX 1024
 #define TEX_BUCKETS 2048
 static MtTex    s_tex[MTL_MAX_TEX];
@@ -662,6 +666,7 @@ static void tex_free(MtTex *t)
     t->va = t->color = t->w = t->h = t->pitch = t->hash = t->bytes = t->face = 0;
     t->fmt = MTLPixelFormatInvalid;
     t->used = t->checked = 0;
+    t->rgen = t->rk = 0;
 }
 
 static void tex_account(MtTex *t, uint32_t bytes)
@@ -779,6 +784,74 @@ static void tex_fill(MtTex *t, uint32_t va, uint32_t layer)
     tex_upload(t, s_decode, w * h * 4, w * 4, h, layer);
 }
 
+static uint64_t fnv64(const uint8_t *p, size_t n, uint64_t h)
+{
+    size_t i;
+    for (i = 0; i < n; i++)
