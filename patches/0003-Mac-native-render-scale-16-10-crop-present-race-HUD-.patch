     return 0;
 }
 
+/* The current batch's screen x range in real pixels (vertex program or
+ * fixed function run on the CPU), for raw-batch hooks that need to know
+ * where a draw lands (NFSU2 hud_wide.c). 0 if a vertex has no image. */
+/* Screen box of the current batch (real pixels: x0, x1, y0, y1) and the
+ * flip count, for title hooks that move 2D (NFSU2 hud_wide.c). */
+int nv2a_pb_batch_screen_box(float *box, uint32_t *flips)
+{
+    uint32_t i;
+    float x0 = 1e30f, x1 = -1e30f, y0 = 1e30f, y1 = -1e30f;
+    for (i = 0; i < s_gpu.idx_count; i++) {
+        float q[4];
+        if (!fetch_position(s_gpu.idx[i], q))
+            return 0;
+        if (q[0] < x0) x0 = q[0];
+        if (q[0] > x1) x1 = q[0];
+        if (q[1] < y0) y0 = q[1];
+        if (q[1] > y1) y1 = q[1];
+    }
+    box[0] = x0; box[1] = x1; box[2] = y0; box[3] = y1;
+    *flips = s_gpu.flips;
+    return s_gpu.idx_count > 0;
+}
+
