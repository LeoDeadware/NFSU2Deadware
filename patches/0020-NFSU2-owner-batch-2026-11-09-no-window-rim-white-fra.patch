@@ -2343,6 +2413,25 @@ void sub_000B5140(void)
 /* Env-map update scheduler (thiscall, 2 args, ret 8). */
 void sub_0009B720(void)
 {
+    /* All six cube faces every frame (owner 2026-11-09 "відображення дригаються"): the
+     * schedule (rows of six dwords at 0x39CE20, row = frame % [0x39CE18], nonzero = this
+     * face now) redraws a few faces per frame, so the paint samples faces from different
+     * frames and car positions and the reflection jerks while driving. The scheduler also
+     * sets up the view of each face it marks, so the rows are filled, not the bytes after
+     * it. Faces are 128x128, ~40 draws each. NFSU2_REFL_ALL=0: the title's schedule. */
+    static int all = -1;
+    if (all < 0) {
+        const char *e = getenv("NFSU2_REFL_ALL");
+        all = !(e && *e == '0');
+        fprintf(stderr, "[refl] cube faces: %s\n", all ? "all six every frame" : "title schedule");
+    }
+    if (all && s_refl) {
+        uint32_t rows = MEM32(0x39CE18), r, j;
+        for (r = 0; r < rows && r < 64; r++)
+            for (j = 0; j < 6; j++)
+                if (!MEM32(0x39CE20 + r * 24 + j * 4))
+                    MEM32(0x39CE20 + r * 24 + j * 4) = 1;
+    }
     sub_0009B720_gen();
     refl_views();
 }
