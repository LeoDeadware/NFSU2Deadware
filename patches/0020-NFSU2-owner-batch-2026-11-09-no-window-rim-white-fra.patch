+/* LOD/cull hysteresis (owner 2026-11-09 "текстури стрибають туди-сюди"): the drawer
+ * culls and picks the model by hard cut-offs on the size (1/16/17/23/32), so an object
+ * whose size wobbles around one (camera sway, a car's bob, the chase camera settling)
+ * pops in and out or swaps model every frame. Remembered per (view, instance position)
+ * for the last frames: once above a cut-off it stays above until the size falls 25 %
+ * under it. NFSU2_LOD_HYST=0 off. NFSU2_POP_LOG=1: crossings per second, raw vs kept. */
+#define LOD_SLOTS 32768u
+static struct { uint32_t key, frame; int32_t raw, out; } s_lod[LOD_SLOTS];
+static const int32_t s_cuts[] = { 2, 16, 17, 23, 32 };
+static unsigned long s_pop_raw, s_pop_out;
+
+static int lod_crossed(int32_t a, int32_t b)
+{
+    unsigned i;
+    for (i = 0; i < sizeof s_cuts / sizeof s_cuts[0]; i++)
+        if ((a >= s_cuts[i]) != (b >= s_cuts[i]))
+            return 1;
+    return 0;
+}
+
+static int32_t lod_hyst(uint32_t obj, uint32_t p, int32_t res)
+{
+    static int on = -1, log_on;
+    static uint32_t log_frame;
+    uint32_t frame = MEM32(0x3EA5E8), key = (p * 2654435761u) ^ (obj * 40503u), h, n;
+    int32_t out = res;
+    unsigned i;
+
+    if (on < 0) {
+        const char *e = getenv("NFSU2_LOD_HYST");
+        on = !(e && *e == '0');
+        e = getenv("NFSU2_POP_LOG");
+        log_on = e && *e == '1';
+        fprintf(stderr, "[lod] cut-off hysteresis %s\n", on ? "on (25 %)" : "off");
+    }
+    for (h = key & (LOD_SLOTS - 1), n = 0; n < 8; n++, h = (h + 1) & (LOD_SLOTS - 1))
+        if (s_lod[h].key == key || frame - s_lod[h].frame > 4u)
+            break;
+    if (n < 8 && s_lod[h].key == key && frame - s_lod[h].frame <= 2u) {
+        if (s_lod[h].frame != frame) {
+            if (on)
+                for (i = 0; i < sizeof s_cuts / sizeof s_cuts[0]; i++) {
+                    int32_t c = s_cuts[i];
+                    if (s_lod[h].out >= c && out < c && out * 4 >= c * 3)
+                        out = c;
+                }
+            s_pop_raw += lod_crossed(s_lod[h].raw, res);
+            s_pop_out += lod_crossed(s_lod[h].out, out);
+        } else {
+            out = s_lod[h].out > out && out * 4 >= s_lod[h].out * 3 ? s_lod[h].out : out;
+        }
+    }
+    if (n < 8) {
+        s_lod[h].key = key;
+        s_lod[h].frame = frame;
+        s_lod[h].raw = res;
+        s_lod[h].out = out;
+    }
+    if (log_on && frame - log_frame >= 60u) {
+        if (log_frame)
+            fprintf(stderr, "[pop] frame %u: %lu raw crossings, %lu kept (60 frames)\n",
+                    frame, s_pop_raw, s_pop_out);
+        log_frame = frame;
+        s_pop_raw = s_pop_out = 0;
+    }
+    return on ? out : res;
+}
