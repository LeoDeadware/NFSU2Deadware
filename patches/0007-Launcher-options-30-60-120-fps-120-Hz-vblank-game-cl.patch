--- a/src/recomp_manual.c
+++ b/src/recomp_manual.c
@@ -23,6 +23,7 @@
 #include <stddef.h>
 #include <string.h>
 #include <stdlib.h>
+#include <time.h>
 #include <math.h>
 
 /* The generated register model (g_eax/g_esp are thread-local there) and the
@@ -412,13 +413,58 @@ extern void nv2a_pb_trap_lock(void);
  * rewrites the interval to 1 as the trap is taken, so a frame ready in time
  * shows on the next vblank (60 fps at most); slower frames are unchanged.
  * NFSU2_FPS_CAP=30 keeps the title's interval. */
+/* NFSU2_FPS_CAP=120 (Mac, launcher "120 fps"): main.c runs the vblank at
+ * 119.88 Hz (RECOMP_VBLANK_HZ=120). Races and the open world flip every
+ * vblank; every other interval is doubled, so menus, movies' screens and the
+ * camera sequences keep the time per frame they had at 59.94 Hz (their
+ * animations step per frame). The game clock (sub_0018A6A0 -> sub_001890C0)
+ * advances by the vblanks counted at 0x4289AC (sub_00098E20, the title's
+ * vblank callback) times 1/60 s, so xbox_after_vblank_dpc below undoes every
+ * other count: 0x4289AC stays a 59.94 Hz counter (clock, timeouts) while the
+ * flips retire at 119.88 Hz. */
+int nfsu2_fps_cap_120(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("NFSU2_FPS_CAP");
+        v = e && atoi(e) == 120;
+    }
+    return v;
+}
+#define fps_cap_120 nfsu2_fps_cap_120
+void xbox_after_vblank_dpc(void)
+{
+    static uint32_t last;
+    static unsigned n;
+    if (!fps_cap_120())
+        return;
+    /* sub_001890C0 clamps each step to at least 0x428EE8 s (1/60, set by
+     * sub_00180AA0/sub_00180AC0), so a 1/120 s frame would still count as
+     * 1/60: halve that floor whenever the title sets it. */
+    float lo = MEMF(0x428EE8);
+    if (lo > 0.0160f && lo < 0.0170f) {
+        static int said;
+        MEMF(0x428EE8) = lo * 0.5f;
+        if (!said++)
+            fprintf(stderr, "[fps] 120 Hz: game step floor %.5f -> %.5f s (NTSC flag %u)\n",
+                    lo, MEMF(0x428EE8), MEM32(0x3A4C50));
+    }
+    uint32_t c = MEM32(0x4289AC);
+    if (c == last)
+        return;
+    if (++n & 1u)
+        MEM32(0x4289AC) = --c;
+    last = c;
+}
 static int fps_cap_30(void)
 {
     static int v = -1;
     if (v < 0) {
         const char *e = getenv("NFSU2_FPS_CAP");
         v = e && atoi(e) == 30;
-        fprintf(stderr, "[fps] race/open-world cap: %s\n", v ? "30 (title)" : "60 (NFSU2_FPS_CAP=30 for 30)");
+        fprintf(stderr, "[fps] race/open-world cap: %s\n", v ? "30 (title)" :
+                fps_cap_120() ? "120 (vblank 119.88 Hz; menus and camera sequences keep their pace)" :
+                "60 (NFSU2_FPS_CAP=30|120)");
     }
     return v;
 }
@@ -449,6 +495,40 @@ static int nis_playing(void)
     return now;
 }
 
+/* RECOMP_FPS_LOG=1: game time against wall time, sampled at each flip.
+ * sub_001890C0 stores the frame's step at 0x4289B4 (1/3600 s units); their
+ * sum per wall second must stay ~3600 at every frame-rate cap. */
+static void game_clock_sample(void)
+{
+    static int on = -1;
+    static uint64_t t0;
+    static uint32_t frames, tot0, step0, vb0;
+    struct timespec ts;
+    uint64_t now;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_FPS_LOG");
+        on = e && *e == '1';
+    }
+    if (!on)
+        return;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    now = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    /* 0x428A20: game time total (sub_00184150 adds each step's ticks);
+     * 0x4289C0: steps; 0x4289AC: the title's vblank count. */
+    if (!t0) {
+        t0 = now; tot0 = MEM32(0x428A20); step0 = MEM32(0x4289C0); vb0 = MEM32(0x4289AC);
+    }
+    frames++;
+    if (now - t0 >= 10000000000ull) {
+        double secs = (now - t0) / 1e9;
+        uint32_t tot = MEM32(0x428A20), step = MEM32(0x4289C0), vb = MEM32(0x4289AC);
+        fprintf(stderr, "[clock] game time %.0f units/s (3600 = real time), %.1f steps/s, "
+                "vblank count %.1f/s, %.1f flips/s\n",
+                (tot - tot0) / secs, (step - step0) / secs, (vb - vb0) / secs, frames / secs);
+        frames = 0; t0 = now; tot0 = tot; step0 = step; vb0 = vb;
+    }
+}
