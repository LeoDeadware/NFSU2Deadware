 {
     volatile uint32_t *nv = (volatile uint32_t *)XBOX_PTR(0xFD000000u);
@@ -461,11 +541,19 @@ void sub_002F22F0(void)
     nsource = nv[0x400108 / 4];
     if (nsource && (nv[0x400704 / 4] & 0xFFFFu) == 0x0100u && !fps_cap_30()) {
         uint32_t data = nv[0x400708 / 4];
-        if ((data & 0x1Fu) == 1u && ((data >> 5) & 7u) > 1u && !nis_playing()) {
+        uint32_t bits = (data >> 5) & 7u;
+        if ((data & 0x1Fu) == 1u)
+            game_clock_sample();
+        if ((data & 0x1Fu) == 1u && bits > 1u && !nis_playing()) {
             static int told;
             nv[0x400708 / 4] = (data & ~(7u << 5)) | (1u << 5);   /* flip: 1 vblank */
             if (!told++)
-                fprintf(stderr, "[fps] flip interval %u -> 1 vblank (uncapped)\n", (data >> 5) & 7u);
+                fprintf(stderr, "[fps] flip interval %u -> 1 vblank (uncapped)\n", bits);
+        } else if ((data & 0x1Fu) == 1u && fps_cap_120() && bits >= 1u && bits < 3u) {
+            static int told;
+            nv[0x400708 / 4] = (data & ~(7u << 5)) | ((bits + 1u) << 5);  /* 1->2, 2->4 vblanks */
+            if (!told++)
+                fprintf(stderr, "[fps] 120 Hz vblank: flip interval code %u -> %u (title's pace)\n", bits, bits + 1u);
         }
     }
     sub_002F22F0_gen();
@@ -527,6 +615,57 @@ void sub_00072F90(void)
  * buffers are swapped as the original does. The border is not filled in:
  * only On2's own motion compensation read it. NFSU2_NATIVE_VP6=0 runs the
  * lifted decoder, =2 runs both and compares the pictures. */
+/* Hold A to skip a movie (Mac, Deadware standard): the EA/THX/PSA logos
+ * and the story movies ignore a press. With A held for 1.5 s while a movie
+ * plays, the movie screen gets the message the start code sends for a
+ * movie that cannot be played (0xC3960EB9 to the FE at 0x406C60, as
+ * sub_0016CD70/sub_0016CFD0 do), and its handler (sub_000DCD20) ends it the
+ * normal way. nfsu2_skip_progress (0..1) draws the indicator on screen
+ * (nv2a_metal present). Once per movie; NFSU2_SKIP=0 off. */
+extern volatile uint8_t usb_gamepad_a_level;
+volatile float nfsu2_skip_progress;
+static int s_skip_sent;
+extern void sub_00166300(void);
+static void movie_skip_tick(void)
+{
+    static int on = -1;
+    static uint64_t down;
+    struct timespec ts;
+    uint64_t now;
+    if (on < 0) {
+        const char *e = getenv("NFSU2_SKIP");
+        on = !(e && *e == '0');
+    }
+    if (!on || s_skip_sent || !MEM32(0x3FBBF4) || MEM32(0x3FBBFC) != 1) {
+        nfsu2_skip_progress = 0;
+        return;
+    }
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    now = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    if (usb_gamepad_a_level < 0x40) {
+        down = 0;
+        nfsu2_skip_progress = 0;
+        return;
+    }
+    if (!down)
+        down = now;
+    nfsu2_skip_progress = (float)((now - down) / 1.5e9);
+    if (nfsu2_skip_progress < 1.0f)
+        return;
+    nfsu2_skip_progress = 0;
+    s_skip_sent = 1;
+    fprintf(stderr, "[movie] A held 1.5 s: skipped\n");
+    {
+        uint32_t ecx_saved = ecx, edx_saved = edx;
+        PUSH32(esp, 0);
+        PUSH32(esp, 0xC3960EB9u);
+        ecx = 0x406C60u;
+        PUSH32(esp, 0x0016CD8Eu);
+        sub_00166300();                 /* thiscall, pops its 2 */
+        ecx = ecx_saved; edx = edx_saved;
+    }
+}
